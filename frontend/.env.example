# ── Supabase Auth ────────────────────────────────────────────────────────────
# Supabase Dashboard → Settings → API
# Project URL and anon/public key — safe to expose in frontend code.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# ── Backend API ──────────────────────────────────────────────────────────────
# Production: set to your Railway backend URL (no trailing slash).
# Local dev: leave unset — Vite's proxy forwards /api and /static to localhost:8000.
VITE_API_BASE_URL=https://your-railway-app.up.railway.app
