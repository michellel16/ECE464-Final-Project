# ── Database (Supabase PostgreSQL) ───────────────────────────────────────────
# Supabase Dashboard → Settings → Database → Connection string → URI
# Use "Session mode" (port 5432) — supports Alembic migrations and SQLAlchemy pooling.
# On Railway: set the variable name to APP_DATABASE_URL (not DATABASE_URL).
# Railway auto-injects its own DATABASE_URL if you add a Postgres addon; APP_DATABASE_URL
# takes priority and lets you use Supabase instead.
APP_DATABASE_URL=postgresql+psycopg2://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

# For local dev you can keep using DATABASE_URL pointing at a local Postgres instance.
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/tunelog

# ── Supabase Auth ────────────────────────────────────────────────────────────
# Supabase Dashboard → Settings → API → Project URL
# Used by the backend to fetch JWKS and validate user tokens.
SUPABASE_URL=https://your-project-ref.supabase.co

# ── JWT / session signing ────────────────────────────────────────────────────
# Used to sign short-lived Spotify OAuth state tokens (not user sessions).
# Generate a strong random value: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-64-char-hex-string

# ── Spotify ──────────────────────────────────────────────────────────────────
# https://developer.spotify.com/dashboard → your app → Settings
# In the dashboard, add SPOTIFY_REDIRECT_URI to "Redirect URIs" — both the
# production URL below AND http://127.0.0.1:8000/api/spotify/callback for local dev.
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret

# Production value → Railway backend URL + /api/spotify/callback
SPOTIFY_REDIRECT_URI=https://your-railway-app.up.railway.app/api/spotify/callback

# ── URLs ─────────────────────────────────────────────────────────────────────
# Production Vercel URL — added to CORS allowed origins and used as the
# destination for Spotify OAuth callbacks after the user approves.
FRONTEND_URL=https://your-app.vercel.app

# ── OpenAI ───────────────────────────────────────────────────────────────────
# Required for semantic (vibe) search embeddings.
# https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...
